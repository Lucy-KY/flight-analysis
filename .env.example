# ── Snowflake Credentials ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

SNOWFLAKE_ACCOUNT=your_account_identifier   # e.g. SFEDU02-UNB02139
SNOWFLAKE_USER=your_username
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8         # RSA private key for MFA bypass
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase  # leave empty if key is unencrypted
SNOWFLAKE_WAREHOUSE=FLIGHT_WH
SNOWFLAKE_DATABASE=FLIGHT_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=TRAINING_ROLE

# ── OpenSky Network (optional – anonymous access works, but registered is better) ──
# Register free at: https://opensky-network.org/index.php?option=com_users&view=registration
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password
